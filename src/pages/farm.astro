---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { withBase } from '@/data/site';

const points = (await getCollection('farmPoints')).sort((a, b) => a.data.number - b.data.number);
const first = points[0];
---
<BaseLayout title="Explore the Farm" description="Explore a clearly illustrative, accessible field-journal map of the gardens, wild edge, flowers, animals, drying, experiments, and seasonal planning at Poor Louis Farms.">
  <PageHeader eyebrow="An interpretive field map" title="Explore the farm through the work." intro="This fold-out scene is an illustration, not a survey or photograph of the private property. Its places represent parts of the farm story and the way ideas move through a season." number="04" />
  <section class="section--tight">
    <div class="container">
      <p id="map-instructions" class="field-note">Choose a numbered point to update the field card. The complete, equivalent list follows the map.</p>
      <div class="farm-map-wrap" data-farm-map>
        <svg class="farm-map-art" viewBox="0 0 1200 620" role="img" aria-labelledby="farm-map-title farm-map-desc">
          <title id="farm-map-title">Illustrative Poor Louis Farms field map</title>
          <desc id="farm-map-desc">A hand-drawn style landscape with mountains, forest edge, garden beds, flowers, animal yard, drying shed, work table, and a winter planning cabin.</desc>
          <defs>
            <pattern id="paperHatch" width="18" height="18" patternUnits="userSpaceOnUse"><path d="M0 18 18 0" stroke="#6c725f" stroke-opacity=".08" /></pattern>
            <pattern id="gardenLines" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M0 20Q13 7 26 20" fill="none" stroke="#526249" stroke-width="2"/></pattern>
          </defs>
          <rect width="1200" height="620" fill="#eae7d4"/><rect width="1200" height="620" fill="url(#paperHatch)"/>
          <path d="M0 245 145 120l92 92L375 73l145 156L682 104l173 140 133-99 212 115v95H0Z" fill="#afc1c4" opacity=".66"/>
          <path d="m0 245 145-125 92 92L375 73l145 156L682 104l173 140 133-99 212 115" fill="none" stroke="#33483f" stroke-width="4" stroke-linejoin="round"/>
          <path d="M0 294c108-61 204-57 304-20 112 42 220 22 328-18 129-47 244-24 358 29 74 35 139 32 210 2v333H0Z" fill="#d0d2af"/>
          <g fill="#375343" stroke="#263c32" stroke-width="2">
            {Array.from({length: 13}).map((_, i) => <path d={`M${35 + i*48} 330l18-55 18 55h-11l14 28h-42l14-28Z`} />)}
          </g>
          <g transform="translate(95 385) rotate(-3)"><path d="M0 90 280 52l88 105-287 36Z" fill="#9aa77a" stroke="#5b664e" stroke-width="3"/><path d="M42 87 315 63M57 113l272-24M73 140l272-25M88 166l271-24" fill="none" stroke="#f1ead7" stroke-width="10"/><path d="M42 87 315 63M57 113l272-24M73 140l272-25M88 166l271-24" fill="none" stroke="#5e724f" stroke-width="3" stroke-dasharray="10 13"/></g>
          <g transform="translate(390 345)" stroke="#684e3e" stroke-width="3"><path d="M0 138V30h160v108" fill="none"/><path d="m-18 45 98-68 98 68" fill="#8f7659"/><rect x="25" y="54" width="110" height="84" fill="#a68b67"/><rect x="66" y="82" width="30" height="56" fill="#504537"/><path d="M37 73h18v20H37m67-20h18v20h-18" fill="#9eb7bd"/></g>
          <g transform="translate(635 390)"><path d="M0 115V34h175v81" fill="none" stroke="#5f4937" stroke-width="3"/><path d="m-20 50 108-68 108 68" fill="#726b55" stroke="#453e31" stroke-width="3"/><path d="M20 66h136M20 84h136M20 102h136" stroke="#8a674b" stroke-width="5"/></g>
          <g transform="translate(858 423)" fill="none" stroke="#493e32" stroke-width="4"><path d="M0 60h176v21H0zM25 81v55m126-55v55"/><path d="M22 38h45v22H22zm66-9h54v31H88z" fill="#bb8c55"/></g>
          <g transform="translate(790 510)" stroke="#544b3e" stroke-width="3" fill="#f2eddb"><ellipse cx="35" cy="35" rx="30" ry="22"/><circle cx="61" cy="27" r="12"/><path d="M18 52v19m20-17v18m37-17v18"/><path d="M96 40q24-31 46 0v23H96Z"/><circle cx="140" cy="33" r="8"/></g>
          <g fill="#a64269" stroke="#6e2948" stroke-width="2">{Array.from({length: 17}).map((_, i) => <circle cx={285 + i*18} cy={345 + Math.sin(i)*21} r="7" />)}</g>
          <path d="M80 555c220-70 379 24 566-9 186-33 317-97 492-38" fill="none" stroke="#8b6448" stroke-width="6" stroke-dasharray="12 14" stroke-linecap="round"/>
        </svg>
        {points.map((point, index) => <button class="map-hotspot" type="button" style={`left:${point.data.x}%;top:${point.data.y}%`} aria-label={`${point.data.number}. ${point.data.name}`} aria-pressed={index === 0 ? 'true' : 'false'} aria-describedby="map-instructions" data-map-point data-id={point.id} data-number={point.data.number} data-name={point.data.name} data-season={point.data.season} data-description={point.data.description} data-note={point.data.note}>{point.data.number}</button>)}
      </div>
      <div class="map-panel" id="map-panel" role="region" aria-live="polite" aria-label="Selected farm field note">
        <span class="map-panel__number" data-panel-number>{String(first.data.number).padStart(2, '0')}</span>
        <div><p class="ledger-label" data-panel-meta>{first.data.season} · {first.data.note}</p><h2 data-panel-title>{first.data.name}</h2><p data-panel-copy>{first.data.description}</p></div>
      </div>
      <noscript><p class="note-box">The interactive field card needs JavaScript. Every point and its full description appears in the list below.</p></noscript>

      <h2 class="section-heading" id="farm-list-title" style="margin-top:5rem">The complete field trail</h2>
      <ol class="farm-list" aria-labelledby="farm-list-title">
        {points.map((point) => <li id={`point-${point.id}`}><span class="farm-list__number" aria-hidden="true">{String(point.data.number).padStart(2, '0')}</span><div><p class="ledger-label">{point.data.season}</p><h3>{point.data.name}</h3><p>{point.data.description}</p><p class="field-note">{point.data.note}</p></div></li>)}
      </ol>
    </div>
  </section>
  <section class="section section--ink"><div class="container split"><div><p class="eyebrow">Keep walking</p><h2>The farm changes when the season turns.</h2></div><div><p>Move from the illustrated places into a winter-to-autumn ledger of planning, growing, gathering, processing, and rest.</p><a class="button button--light" href={withBase('/seasons/')}>Explore the seasons</a></div></div></section>
  <script>
    const mapButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-map-point]')];
    const number = document.querySelector('[data-panel-number]');
    const meta = document.querySelector('[data-panel-meta]');
    const title = document.querySelector('[data-panel-title]');
    const copy = document.querySelector('[data-panel-copy]');
    for (const button of mapButtons) button.addEventListener('click', () => {
      for (const item of mapButtons) item.setAttribute('aria-pressed', String(item === button));
      if (number) number.textContent = String(button.dataset.number).padStart(2, '0');
      if (meta) meta.textContent = `${button.dataset.season} · ${button.dataset.note}`;
      if (title) title.textContent = button.dataset.name ?? '';
      if (copy) copy.textContent = button.dataset.description ?? '';
    });
  </script>
</BaseLayout>
