---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ShopNote from '@/components/ShopNote.astro';
import { productImages } from '@/data/media';
import { withBase } from '@/data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const ingredients = await getCollection('ingredients');
const articles = await getCollection('journal');
const relatedIngredients = ingredients.filter((entry) => product.data.ingredients.includes(entry.id));
const relatedArticles = articles.filter((entry) => entry.data.relatedProducts.includes(product.id)).slice(0, 3);
const image = productImages[product.data.imageKey as keyof typeof productImages];
---
<BaseLayout title={product.data.name} description={product.data.summary}>
  <Breadcrumbs items={[{ label: 'Products', href: '/products/' }, { label: product.data.name }]} />
  <article class="container product-detail">
    <figure class="product-detail__visual">
      <Image src={image} alt={product.data.alt} widths={[480, 720, 960, 1280]} sizes="(max-width: 768px) 92vw, 42vw" format="webp" loading="eager" />
      <figcaption>Official product photograph from the Poor Louis Farms Square store.</figcaption>
    </figure>
    <div>
      <p class="eyebrow">{product.data.category} · Square catalog reviewed {product.data.sourceReviewed}</p>
      <h1>{product.data.name}</h1>
      <p class="lede">{product.data.summary}</p>
      <p class="product-detail__profile"><strong>Profile:</strong> {product.data.profile}</p>

      <section class="detail-section" aria-labelledby="known-title">
        <h2 id="known-title">What the current listing confirms</h2>
        <ul class="fact-list">{product.data.verified.map((fact) => <li>{fact}</li>)}</ul>
      </section>

      {product.data.uses.length > 0 && <section class="detail-section" aria-labelledby="uses-title"><h2 id="uses-title">Ways to use it</h2><ul>{product.data.uses.map((use) => <li>{use}</li>)}</ul></section>}

      {relatedIngredients.length > 0 && <section class="detail-section" aria-labelledby="ingredients-title"><h2 id="ingredients-title">Follow the ingredients</h2><ul class="related-strip">{relatedIngredients.map((ingredient) => <li><a href={withBase(`/ingredients/${ingredient.id}/`)}>{ingredient.data.name} <span aria-hidden="true">→</span></a></li>)}</ul></section>}

      <section class="detail-section" aria-labelledby="process-title"><h2 id="process-title">Process trail</h2><p>{product.data.processes.map((process) => process.replaceAll('-', ' ')).join(' · ')}</p><a class="text-link" href={withBase('/making/')}>See what each step means <span aria-hidden="true">→</span></a></section>

      {relatedArticles.length > 0 && <section class="detail-section" aria-labelledby="reading-title"><h2 id="reading-title">Related field notes</h2><ul>{relatedArticles.map((article) => <li><a href={withBase(`/journal/${article.id}/`)}>{article.data.title}</a></li>)}</ul></section>}

      <div class="note-box"><strong>A note on changing details</strong> This page intentionally omits price, inventory, fulfillment, and option status. Those details can change without a site rebuild.</div>
      <ShopNote compact title={`Looking for ${product.data.name}?`} productUrl={product.data.squareUrl} label="Check current availability" />
    </div>
  </article>
</BaseLayout>
