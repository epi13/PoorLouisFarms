---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { productImages } from '@/data/media';
import { withBase } from '@/data/site';

interface Props { product: CollectionEntry<'products'>; eager?: boolean; }
const { product, eager = false } = Astro.props;
const image = productImages[product.data.imageKey as keyof typeof productImages];
---
<article class="product-card" data-catalog-item data-category={product.data.category.toLowerCase()} data-search={`${product.data.name} ${product.data.category} ${product.data.summary}`.toLowerCase()}>
  <a class="product-card__image" href={withBase(`/products/${product.id}/`)} tabindex="-1" aria-hidden="true">
    <Image
      src={image}
      alt=""
      widths={[320, 480, 720]}
      sizes="(max-width: 600px) 92vw, (max-width: 1000px) 45vw, 30vw"
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="product-card__content">
    <p class="ledger-label">{product.data.category}</p>
    <h2><a href={withBase(`/products/${product.id}/`)}>{product.data.name}</a></h2>
    <p>{product.data.summary}</p>
    <div class="product-card__actions">
      <a class="text-link" href={withBase(`/products/${product.id}/`)}>Explore this product <span aria-hidden="true">→</span></a>
      <a class="square-link" href={product.data.squareUrl} target="_blank" rel="noopener noreferrer">Square <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </div>
</article>
